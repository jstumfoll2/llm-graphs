+  function redrawWakeWidget(): void {
+    if (wakeDisplay !== "widget" || !wakeUi?.setWidget) return;
+    const last = wakeHistory.at(-1);
+    if (!last) {
+      wakeUi.setWidget(wakeWidgetKey, undefined);
+      return;
+    }
+    const lines = last.message.split("\n").map((line) => line.trim()).filter(Boolean);
+    const shown = lines.slice(0, 3).map((line) => `  ${line.length > 160 ? `${line.slice(0, 157)}...` : line}`);
+    if (lines.length > shown.length) shown.push(`  ... ${lines.length - shown.length} more line(s), /fm-wakes for all`);
+    const count = wakeHistory.length === 1 ? "1 wake" : `${wakeHistory.length} wakes`;
+    try {
+      wakeUi.setWidget(wakeWidgetKey, [`Firstmate watcher: ${count} this session, last at ${clock(last.at)}`, ...shown]);
